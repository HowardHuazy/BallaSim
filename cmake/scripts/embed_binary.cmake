# Script mode (cmake -P): writes OUTPUT, a C++ source holding the bytes of INPUT.
foreach(_var INPUT OUTPUT SYMBOL NAMESPACE)
  if(NOT DEFINED ${_var})
    message(FATAL_ERROR "embed_binary.cmake: ${_var} is not set")
  endif()
endforeach()
list(LENGTH INPUT _n)
if(NOT _n EQUAL 1)
  message(FATAL_ERROR "embed_binary.cmake: expected exactly one input file, got '${INPUT}'")
endif()

file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _hex_len)
math(EXPR _size "${_hex_len} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
# Break the initializer into lines of 24 bytes so the generated file stays readable by tools.
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n  " _bytes "${_bytes}")

file(WRITE "${OUTPUT}.tmp"
"// Generated by cmake/scripts/embed_binary.cmake from ${INPUT}. Do not edit.
#include <cstddef>

namespace ${NAMESPACE} {
extern const unsigned char ${SYMBOL}[];
extern const std::size_t ${SYMBOL}Size;
const unsigned char ${SYMBOL}[] = {
  ${_bytes}
};
const std::size_t ${SYMBOL}Size = ${_size};
}  // namespace ${NAMESPACE}
")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
